# Fint Likvid — Environment Configuration
# Copy this file to .env and fill in real values.
# POSTGRES_PASSWORD is REQUIRED — docker-compose will refuse to start without it.

# ─── App runtime ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
BACKEND_PORT=8000

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_DEFAULT_FORECAST_MONTHS=6
VITE_MAX_FORECAST_MONTHS=24
VITE_CURRENCY=SEK

# ─── Wint API ─────────────────────────────────────────────────────────────────
WINT_API_BASE_URL=https://superkollapi.wint.se
WINT_BANK_ACCOUNT_NUMBER=1930

# Optional internal API base URL (leave blank unless advised by Wint support)
WINT_API_INTERNAL_BASE_URL=https://superkollapi.wint.se

# Bootstrap behavior
# WINT_BOOTSTRAP_ON_STARTUP=true  -> read credentials from .env, encrypt, store in DB
# WINT_BOOTSTRAP_ON_STARTUP=false -> use credentials already stored in DB
WINT_BOOTSTRAP_ON_STARTUP=true
WINT_BOOTSTRAP_REQUIRE_EMPTY_DB=true
CACHE_REFRESH_INTERVAL_HOURS=6

# Wint Basic Auth credentials (required when WINT_BOOTSTRAP_ON_STARTUP=true)
WINT_API_USERNAME=your-username
WINT_API_PASSWORD=your-password

# API request behaviour
WINT_API_TIMEOUT_SECONDS=30
WINT_USE_INTERNAL_API=false

# ─── Encryption ───────────────────────────────────────────────────────────────
# Fernet key used to encrypt stored Wint credentials.
# Auto-generated on first startup and saved to ./data/config.json.
# Back up ./data/config.json — losing it requires re-running the setup wizard.
# To pre-generate a key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD is REQUIRED — docker-compose will not start without it.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wintstatus
POSTGRES_USER=wintstatus
POSTGRES_PASSWORD=change-me-before-deploying

# Backend connection string (used when running outside Docker)
DATABASE_URL=postgresql://wintstatus:change-me-before-deploying@localhost:5433/wintstatus
